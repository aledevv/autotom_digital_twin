#usda 1.0
(
    defaultPrim = "Plant_1"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Plant_1"
{
    custom int autotom:plantId = 1
    custom string autotom:plantStateSchema = "plant_state/1.0"
    custom string autotom:renderer = "exporterV1/plant_state"
    custom double autotom:simulationTime = 1

    def Scope "Materials"
    {
        def Material "Stem"
        {
            token outputs:surface.connect = </Plant_1/Materials/Stem/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.3, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Root"
        {
            token outputs:surface.connect = </Plant_1/Materials/Root/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.35, 0.15)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Leaf"
        {
            token outputs:surface.connect = </Plant_1/Materials/Leaf/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.55, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Pedicel"
        {
            token outputs:surface.connect = </Plant_1/Materials/Pedicel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.5, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "FruitRipe"
        {
            token outputs:surface.connect = </Plant_1/Materials/FruitRipe/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.17, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "FruitUnripe"
        {
            token outputs:surface.connect = </Plant_1/Materials/FruitUnripe/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.58, 0.25)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

