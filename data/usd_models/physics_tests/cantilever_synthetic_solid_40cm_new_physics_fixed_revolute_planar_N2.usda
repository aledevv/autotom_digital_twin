#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Stem" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        custom string cantilever:configFingerprint = "6aec0fd85d0d2e9b"
        custom string cantilever:configJson = '{"backend":"cpu","benchmark":"synthetic_solid_40cm","collisions_enabled":false,"joint_model":"revolute_planar","model":"new_physics","n_links":2,"schema_version":2,"support":"fixed"}'
        bool physxArticulation:enabledSelfCollisions = 0
        float physxArticulation:sleepThreshold = 0
        int physxArticulation:solverPositionIterationCount = 255
        int physxArticulation:solverVelocityIterationCount = 32

        def Xform "root_anchor_Link_01" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0.05)
            float physics:mass = 0.50265485
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cylinder "Cylinder"
            {
                uniform token axis = "Z"
                double height = 0.1
                double radius = 0.04
                double3 xformOp:translate = (0, 0, 0.05)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def PhysicsFixedJoint "RootFixedJoint"
            {
                rel physics:body1 = </World/Stem/root_anchor_Link_01>
            }
        }

        def Xform "cantilever_synthetic_solid_40cm_N2_Link_01" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0.1)
            prepend rel physics:filteredPairs = </World/Stem/root_anchor_Link_01>
            float physics:mass = 0.06283186
            quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
            double3 xformOp:translate = (0, 0.02, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cylinder "Cylinder"
            {
                uniform token axis = "Z"
                double height = 0.2
                double radius = 0.01
                double3 xformOp:translate = (0, 0, 0.1)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def PhysicsFixedJoint "AttachJoint"
            {
                rel physics:body0 = </World/Stem/root_anchor_Link_01>
                rel physics:body1 = </World/Stem/cantilever_synthetic_solid_40cm_N2_Link_01>
                point3f physics:localPos0 = (0, 0.02, 0.1)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, -0.70710677, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        def Xform "cantilever_synthetic_solid_40cm_N2_Link_02" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0.1)
            prepend rel physics:filteredPairs = </World/Stem/cantilever_synthetic_solid_40cm_N2_Link_01>
            float physics:mass = 0.06283186
            quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
            double3 xformOp:translate = (0, 0.22, 0.10000000000000005)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cylinder "Cylinder"
            {
                uniform token axis = "Z"
                double height = 0.2
                double radius = 0.01
                double3 xformOp:translate = (0, 0, 0.1)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def PhysicsRevoluteJoint "Joint_01_02" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.0020040262
                float drive:angular:physics:stiffness = 0.06853892
                float drive:angular:physics:targetPosition = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </World/Stem/cantilever_synthetic_solid_40cm_N2_Link_01>
                rel physics:body1 = </World/Stem/cantilever_synthetic_solid_40cm_N2_Link_02>
                point3f physics:localPos0 = (0, 0, 0.2)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                float physics:lowerLimit = -30
                float physics:upperLimit = 30
            }
        }
    }

    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableCCD = 1
        bool physxScene:enableGPUDynamics = 0
        bool physxScene:enableStabilization = 1
        uniform token physxScene:solverType = "TGS"
        uint physxScene:timeStepsPerSecond = 480
    }
}

