                rel skel:animationSource = </World/StemVisual/SkelRoot/SkelAnim>
            }

            def SkelAnimation "SkelAnim"
            {
                uniform token[] joints = ["Bone0", "Bone0/Bone1", "Bone0/Bone1/Bone2"]
                quatf[] rotations = [(0.70710677, -0.70710677, 0, 0), (0.9698463, 0.03015369, 0.17101008, 0.17101008), (0.9698463, 0.08682409, 0.15038373, 0.17101008)]
