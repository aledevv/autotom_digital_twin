#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableCCD = 1
        bool physxScene:enableGPUDynamics = 1
        bool physxScene:enableStabilization = 1
        uniform token physxScene:solverType = "TGS"
        uint physxScene:timeStepsPerSecond = 120
    }

    def Xform "Stem" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        float physxArticulation:sleepThreshold = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1

        def Xform "Branch_Link_01" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.05
            bool physics:rigidBodyEnabled = 1
            quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
            double3 xformOp:translate = (0, 0, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cylinder "Collider" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                double height = 0.1
                double radius = 0.012
                double3 xformOp:translate = (0, 0, 0.05)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def PhysicsFixedJoint "RootFixedJoint"
            {
                rel physics:body1 = </World/Stem/Branch_Link_01>
            }
        }

        def Xform "Branch_Link_02" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.05
            bool physics:rigidBodyEnabled = 1
            quatf xformOp:orient = (0.70710677, -0.66446304, 0.24184476, 0)
            double3 xformOp:translate = (0, 0.101, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cylinder "Collider" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                double height = 0.1
                double radius = 0.012
                double3 xformOp:translate = (0, 0, 0.05)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def PhysicsJoint "Joint_01_02" (
                prepend apiSchemas = ["PhysicsLimitAPI:transX", "PhysicsLimitAPI:transY", "PhysicsLimitAPI:transZ", "PhysicsLimitAPI:rotX", "PhysicsDriveAPI:rotX", "PhysicsLimitAPI:rotY", "PhysicsDriveAPI:rotY", "PhysicsLimitAPI:rotZ"]
            )
            {
                float drive:rotX:physics:damping = 0.05
                float drive:rotX:physics:stiffness = 0
                float drive:rotX:physics:targetPosition = 0
                uniform token drive:rotX:physics:type = "force"
                float drive:rotY:physics:damping = 0.05
                float drive:rotY:physics:stiffness = 0
                float drive:rotY:physics:targetPosition = 0
                uniform token drive:rotY:physics:type = "force"
                float limit:rotX:physics:high = 89
                float limit:rotX:physics:low = -89
                float limit:rotY:physics:high = 89
                float limit:rotY:physics:low = -89
                float limit:rotZ:physics:high = -1
                float limit:rotZ:physics:low = 1
                float limit:transX:physics:high = -1
                float limit:transX:physics:low = 1
                float limit:transY:physics:high = -1
                float limit:transY:physics:low = 1
                float limit:transZ:physics:high = -1
                float limit:transZ:physics:low = 1
                rel physics:body0 = </World/Stem/Branch_Link_01>
                rel physics:body1 = </World/Stem/Branch_Link_02>
                point3f physics:localPos0 = (0, 0, 0.101)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (0.9698463, -0.03015369, -0.17101008, -0.17101008)
            }
        }

        def Xform "Branch_Link_03" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.05
            bool physics:rigidBodyEnabled = 1
            quatf xformOp:orient = (0.70710677, -0.5416752, 0.45451948, 0)
            double3 xformOp:translate = (0.03454403447589254, 0.19590895469937675, 0.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cylinder "Collider" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "Z"
                double height = 0.1
                double radius = 0.012
                double3 xformOp:translate = (0, 0, 0.05)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def PhysicsJoint "Joint_02_03" (
                prepend apiSchemas = ["PhysicsLimitAPI:transX", "PhysicsLimitAPI:transY", "PhysicsLimitAPI:transZ", "PhysicsLimitAPI:rotX", "PhysicsDriveAPI:rotX", "PhysicsLimitAPI:rotY", "PhysicsDriveAPI:rotY", "PhysicsLimitAPI:rotZ"]
            )
            {
                float drive:rotX:physics:damping = 0.05
                float drive:rotX:physics:stiffness = 0
                float drive:rotX:physics:targetPosition = 0
                uniform token drive:rotX:physics:type = "force"
                float drive:rotY:physics:damping = 0.05
                float drive:rotY:physics:stiffness = 0
                float drive:rotY:physics:targetPosition = 0
                uniform token drive:rotY:physics:type = "force"
                float limit:rotX:physics:high = 89
                float limit:rotX:physics:low = -89
                float limit:rotY:physics:high = 89
                float limit:rotY:physics:low = -89
                float limit:rotZ:physics:high = -1
                float limit:rotZ:physics:low = 1
                float limit:transX:physics:high = -1
                float limit:transX:physics:low = 1
                float limit:transY:physics:high = -1
                float limit:transY:physics:low = 1
                float limit:transZ:physics:high = -1
                float limit:transZ:physics:low = 1
                rel physics:body0 = </World/Stem/Branch_Link_02>
                rel physics:body1 = </World/Stem/Branch_Link_03>
                point3f physics:localPos0 = (0, 0, 0.101)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (0.9698463, -0.08682409, -0.15038373, -0.17101008)
            }
        }
    }

