        {
            token outputs:surface.connect = </World/Looks/TomatoStem/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.4, 0.18)
                float inputs:metallic = 0
                float inputs:roughness = 0.68
                token outputs:surface
            }
        }

        def Scope "TomatoFruit"
        {
            def Material "Maturation_7"
            {
                token outputs:surface.connect = </World/Looks/TomatoFruit/Maturation_7/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    float inputs:clearcoat = 0.28
                    float inputs:clearcoatRoughness = 0.18
                    color3f inputs:diffuseColor = (0.9, 0.17, 0.08)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.28
                    token outputs:surface
                }
            }
        }
    }
