    def Xform "Materials"
    {
        def Material "Stem"
        {
            token outputs:surface.connect = </World/Materials/Stem/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.3, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def PhysicsScene "PhysicsScene" (
