#usda 1.0
(
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def "World"
{
    def Xform "Plant"
    {
        def Xform "Stem_01" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 1000
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cylinder "Cylinder"
            {
                uniform token axis = "Z"
                double height = 0.24046128000000003
                color3f[] primvars:displayColor = [(0.35, 0.62, 0.2)]
                double radius = 0.02999789569138933
                double3 xformOp:translate = (0, 0, 0.12023064000000001)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body1 = </World/Plant/Stem_01>
            }
        }
    }
}

